{
  "name": "Battle",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "Remotes": {
        "$className": "Folder",
        "SpawnClone": {
          "$className": "RemoteEvent"
        },
        "MoveClones": {
          "$className": "RemoteEvent"
        }
      }
    },

    "Workspace": {
      "Terrain": {
        "$path": "assets/terrain.rbxmx"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "Scriptable",
        "DevTouchMovementMode": "Scriptable"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
